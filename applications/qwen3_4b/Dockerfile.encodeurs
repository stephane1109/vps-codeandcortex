FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir "transformers>=4.44,<5" "huggingface_hub>=0.26,<1" "fastapi>=0.115,<1" "uvicorn>=0.34,<1" "safetensors>=0.4,<1"
COPY encodeurs_specialises.py /app/encodeurs_specialises.py
EXPOSE 8502
CMD ["uvicorn", "encodeurs_specialises:application", "--host", "0.0.0.0", "--port", "8502"]
