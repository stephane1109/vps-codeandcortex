# Facultatif : protection de l'application par un mot de passe HTTP.
APP_ACCESS_USER=scraptiktok
APP_ACCESS_PASSWORD=
# Mettre 1 lorsque l'application est servie en HTTPS.
COOKIE_SECURE=0
# Port local pour docker compose (le port interne reste 8501).
PORT=8501

# Construction Compose : 1 installe le traitement audiovisuel facultatif.
INSTALL_VIDEO=0
MEM_LIMIT=2g
