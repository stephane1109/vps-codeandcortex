# Facultatif : protection de l'application par un mot de passe HTTP.
APP_ACCESS_USER=scraptiktok
APP_ACCESS_PASSWORD=
# Mettre 1 lorsque l'application est servie en HTTPS.
COOKIE_SECURE=0
# Port local pour docker compose (le port interne reste 8501).
PORT=8501

# Profils : 0 textes, base réemploi, semantique CLIP CPU, 1 ajoute OCR/Whisper.
INSTALL_VIDEO=semantique
MEM_LIMIT=2g

# Facultatif, réservé à l'administrateur : fichier Netscape monté en lecture seule.
# Appliqué aux méthodes Presse API, Selenium et Playwright avant la navigation.
# Ne jamais placer ce fichier dans Git, les exports ou un dossier public.
SCRAPTIKTOK_COOKIES_FILE=

# Research API officielle : nécessaire pour les programmes pluri-journaliers.
# Configurer les valeurs réelles dans les secrets Coolify, pas dans Git.
TIKTOK_RESEARCH_CLIENT_KEY=
TIKTOK_RESEARCH_CLIENT_SECRET=
# Budget prudent par jour UTC et par instance (1 à 1000).
RESEARCH_QUOTA_LOCAL_JOUR=900
# Conserver /app/data sur un volume persistant (déjà prévu par compose.yaml).
DATA_DIR=/app/data

# Facultatif : archivage du corpus dans un PostgreSQL distinct de SQLite.
# Exemple de schéma, renseigner le secret réel uniquement dans Coolify.
RESEARCH_POSTGRES_DSN=
