# Exemple de réglage Coolify pour ScrapTikTok uniquement.
# Copier ces valeurs dans les variables d'environnement du service ScrapTikTok.
# Ce fichier n'est pas chargé automatiquement et ne contient PAS de secrets.
# L'API web de TikTok n'a pas de quotas publics chiffrés : ceux-ci sont LOCAUX.
#
# Garder REDIS_URL hors du dépôt. Renouveler le mot de passe Redis déjà divulgué
# et actualiser les services qui utilisent le même Redis.
#
# REDIS_URL doit rester configurée comme secret dans Coolify.
APP_TICKET_ID=scraptiktok
APP_TICKET_ENFORCED=1
APP_TICKET_MAX_ACTIVE=1
APP_TICKET_COST=2
CAPACITE_SERVEUR=10
APP_TICKET_TTL_SECONDS=1800
APP_TICKET_HEARTBEAT_MS=60000
APP_TICKET_HIDDEN_RELEASE_SECONDS=300
APP_TICKET_MAX_WAITING=5
APP_TICKET_WAIT_REFRESH_MS=10000
APP_TICKET_RELEASE_URL=https://vps.codeandcortex.fr/api/tickets/release
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SECONDS=1200
IDLE_TIMEOUT_SECONDS=600

# Aucun plafond Coolify additionnel sur les publications, sources,
# commentaires, défilements ou pages API.
# Les anciennes variables SCRAPTIKTOK_MAX_POSTS_PER_SOURCE,
# SCRAPTIKTOK_MAX_SOURCES_PER_JOB, SCRAPTIKTOK_MAX_COMMENTS_PER_VIDEO,
# SCRAPTIKTOK_MAX_SCROLLS et SCRAPTIKTOK_API_MAX_PAGES_PER_SOURCE
# sont ignorées par le code. Les bornes techniques du formulaire,
# les limites de durée et les refus TikTok restent actifs.

# Plafonds LOCAUX du moteur API Presse : 50 % des références numériques.
# 600/min -> 300/min ; 1000/jour -> 500/jour ; 100000 objets/jour -> 50000.
# Ces chiffres ne constituent pas des quotas officiels applicables au scraping.
# Un ancien chiffre supérieur dans Coolify est borné par le code ; un chiffre
# inférieur est conservé. Ces limites ne mesurent pas Selenium.
SCRAPTIKTOK_API_MIN_INTERVAL_SECONDS=0
SCRAPTIKTOK_API_MAX_REQUESTS_PER_MINUTE=300
SCRAPTIKTOK_API_MAX_REQUESTS_PER_HOUR=500
SCRAPTIKTOK_API_MAX_REQUESTS_PER_DAY=500
SCRAPTIKTOK_API_MAX_RECORDS_PER_DAY=50000

# À conserver si les durées de rétention actuelles conviennent :
RESULT_TTL_SECONDS=86400
CHECKPOINT_TTL_SECONDS=604800

PORT=8501
# Le contenu de REDIS_URL (secret) n'est jamais copié dans le dépôt.
# Le TTL Redis de 30 min n'est PAS un arrêt absolu : le client le renouvelle
# tant qu'il est actif. JOB_TIMEOUT_SECONDS impose la durée maximale du job.
# La limite d'appels API Presse ne compte pas le trafic Selenium du navigateur ;
# les bornes techniques et la durée maximale des collectes restent appliquées.
